import tkinter as tk

from datetime import datetime

class ReminderApp:

    def __init__(self):

        self.root = tk.Tk()

        self.root.title("Мои задачи")

        self.root.geometry("1920x1080")

        self.root.configure(bg="black")

        title = tk.Label(

            self.root,

            text="Мои текущие задачи",

            font=("Arial", 28, "bold"),

            fg="yellow",

            bg="black"

        )

        title.pack(pady=20)

        self.tasks = [

            ("Сдать лабораторную", "2025-06-01"),

            ("Подготовиться к экзамену", "2025-06-10"),

            ("Купить подарок", "2025-06-20"),

            ("Сходить в кино", "2025-07-01"),

            ("Поехать отдыхать", "2026-08-15")

        ]

        for task, date in self.tasks:

            self.show_task(task, date)

        self.root.mainloop()

    def show_task(self, task, date):

        today = datetime.now()

        task_date = datetime.strptime(date, "%Y-%m-%d")

        days = (task_date - today).days

        if days > 0:

            text = f"Осталось {days} дней до {task}"

            color = "white"

        elif days == 0:

            text = f"Сегодня: {task}"

            color = "orange"

        else:

            text = f"Прошло {-days} дней от {task}"

            color = "red"

        label = tk.Label(

            self.root,

            text=text,

            font=("Arial", 16),

            fg=color,

            bg="black"

        )

        label.pack(anchor="w", padx=40, pady=5)

if name == "__main__":

    ReminderApp()
