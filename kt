import random

print("Вы пришли к глухой бабушке. для прекращения разговора введите 'ПОКА!')")

while True:
    user_input = input("Вы: ")
    
    # Проверяем, хочет ли пользователь закончить разговор
    if user_input == "ПОКА!":
        print("Бабушка: НУ ЗАХОДИ ЕЩЁ!")
        break
    
    # Проверяем, кричит ли пользователь (все буквы заглавные)
    if user_input.isupper():
        # Генерируем случайный год между 1930 и 1950
        year = random.randint(1930, 1950)
        print(f"Бабушка: НЕТ, НИ РАЗУ С {year} ГОДА!")
    else:
        print("Бабушка: АСЬ?! ГОВОРИ ГРОМЧЕ, ВНУЧЕК!")
